-- Announcement table: club-specific updates visible to all members of that club.
-- Posted by teachers or student leaders; no in-app messaging or discussion forums.

CREATE TABLE announcements (
    id            TEXT PRIMARY KEY,
    club_id       TEXT    NOT NULL REFERENCES clubs(id) ON DELETE CASCADE,
    title         TEXT    NOT NULL,
    content       TEXT    NOT NULL,
    -- The user who posted the announcement
    author_id     TEXT    NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
    -- Whether the announcement is still active (archived announcements are hidden)
    is_active     INTEGER NOT NULL DEFAULT 1,
    posted_at     TEXT    NOT NULL DEFAULT (datetime('now')),
    updated_at    TEXT    NOT NULL DEFAULT (datetime('now'))
);

-- Index for querying active announcements by club (most recent first)
CREATE INDEX IF NOT EXISTS idx_announcements_club_id ON announcements(club_id);

-- Index for time-based queries (recent announcements across all clubs)
CREATE INDEX IF NOT EXISTS idx_announcements_posted_at ON announcements(posted_at);
