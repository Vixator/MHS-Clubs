-- User table: stores authenticated user profiles.
-- Role is determined at sign-in by email domain:
--   @students.mcpasd.k12.wi.us → 'student'
--   @mcpasd.k12.wi.us          → 'teacher'
-- Student Leader is a per-club flag on Membership, not a top-level role.

CREATE TABLE users (
    id          TEXT PRIMARY KEY,
    firebase_uid TEXT    NOT NULL UNIQUE,
    email       TEXT    NOT NULL,
    display_name TEXT   NOT NULL,
    role        TEXT    NOT NULL CHECK (role IN ('student', 'teacher')),
    -- Image URL from Google profile, nullable
    avatar_url  TEXT,
    -- Timestamps in ISO-8601 format
    created_at  TEXT    NOT NULL DEFAULT (datetime('now')),
    updated_at  TEXT    NOT NULL DEFAULT (datetime('now'))
);

-- Index for quick lookups by Firebase auth UID
CREATE INDEX IF NOT EXISTS idx_users_firebase_uid ON users(firebase_uid);

-- Index for quick lookups by email (e.g. during sign-in)
CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);
