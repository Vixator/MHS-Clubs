-- ClubOverride table: local, in-app edits to club details.
-- These edits are stored in PostgreSQL as overrides layered on top of
-- the source Sheet data and never written back to the master spreadsheet.
-- Each override targets a single mutable field on a club.

CREATE TABLE club_overrides (
    id          TEXT PRIMARY KEY,
    club_id     TEXT    NOT NULL REFERENCES clubs(id) ON DELETE CASCADE,
    -- Which field this override applies to: 'meeting_day', 'meeting_time', 'meeting_location'
    field_name  TEXT    NOT NULL CHECK (field_name IN ('meeting_day', 'meeting_time', 'meeting_location')),
    -- The override value (TEXT; each field stores its value as text)
    value       TEXT    NOT NULL,
    -- Who made the override (user ID of the teacher or student leader)
    updated_by  TEXT    NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
    updated_at  TEXT    NOT NULL DEFAULT (datetime('now')),
    -- Only one override per (club_id, field_name) at a time
    UNIQUE(club_id, field_name)
);

-- Index for looking up all overrides for a given club
CREATE INDEX IF NOT EXISTS idx_club_overrides_club_id ON club_overrides(club_id);
