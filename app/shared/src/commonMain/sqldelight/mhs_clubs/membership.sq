-- Membership table: links Users to Clubs and tracks their role/status.
-- Roles:
--   'member'      — standard joined member
--   'officer'     — club officer (president, VP, secretary, treasurer, etc.)
--   'student_leader' — student granted admin privileges for this specific club
-- Status:
--   'active'      — currently a member
--   'pending'     — membership request submitted, awaiting approval
--   'revoked'     — membership was revoked (e.g. by a teacher admin)

CREATE TABLE memberships (
    id          TEXT PRIMARY KEY,
    user_id     TEXT    NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    club_id     TEXT    NOT NULL REFERENCES clubs(id) ON DELETE CASCADE,
    role        TEXT    NOT NULL DEFAULT 'member'
                    CHECK (role IN ('member', 'officer', 'student_leader')),
    status      TEXT    NOT NULL DEFAULT 'pending'
                    CHECK (status IN ('pending', 'active', 'revoked')),
    joined_at   TEXT    NOT NULL DEFAULT (datetime('now')),
    -- When a teacher granted student_leader status (null if never granted)
    leader_granted_at TEXT,
    -- When membership was revoked (null if not revoked)
    revoked_at  TEXT,
    -- Only one active/pending membership per (user_id, club_id)
    UNIQUE(user_id, club_id)
);

-- Index for looking up all memberships for a given user
CREATE INDEX IF NOT EXISTS idx_memberships_user_id ON memberships(user_id);

-- Index for looking up all members of a given club
CREATE INDEX IF NOT EXISTS idx_memberships_club_id ON memberships(club_id);

-- Index for quick lookup of student leaders per club
CREATE INDEX IF NOT EXISTS idx_memberships_student_leader ON memberships(club_id, role)
    WHERE role = 'student_leader';
