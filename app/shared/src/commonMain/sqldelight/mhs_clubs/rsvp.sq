-- RSVP table: links Users to Events, tracking attendance intent/status.
-- This is separate from Attendance (who showed up) — RSVP is who said
-- they would come.

CREATE TABLE rsvps (
    id            TEXT PRIMARY KEY,
    event_id      TEXT    NOT NULL REFERENCES events(id) ON DELETE CASCADE,
    user_id       TEXT    NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    -- RSVP status: 'going', 'maybe', 'not_going'
    status        TEXT    NOT NULL DEFAULT 'going'
                    CHECK (status IN ('going', 'maybe', 'not_going')),
    -- When the user submitted their RSVP
    responded_at  TEXT    NOT NULL DEFAULT (datetime('now')),
    -- Only one RSVP per (user_id, event_id) at a time
    UNIQUE(event_id, user_id)
);

-- Index for looking up all RSVPs for an event
CREATE INDEX IF NOT EXISTS idx_rsvps_event_id ON rsvps(event_id);

-- Index for looking up all RSVPs by a user
CREATE INDEX IF NOT EXISTS idx_rsvps_user_id ON rsvps(user_id);
