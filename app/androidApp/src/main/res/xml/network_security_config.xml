<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP only for local development hosts (the Android emulator
  maps 10.0.2.2 to the host loopback). Production traffic to the deployed site
  host remains HTTPS-only, matching the reverse-proxied API described in README.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
